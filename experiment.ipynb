#Number of clusters: 24
#Largest 15 clusters:
#cluster
#0     2631
#1      590

#Here we can see that, 2631 earthquakes or 67.91% of total earthqaukes over the world have been clustered into a single group, which isn't normal
#so we need to rethink about the radius size, that is the value of Eps








#Finding the Best 'Eps' that results into normal cluster chunks
eps_values = [100,150,200,250,300,400, 450]

results = []

for eps_km in eps_values:

  eps_rad = eps_km / 6371.0088

  model = DBSCAN(
      eps=eps_rad,
      min_samples=5,
      metric='haversine',
      algorithm='ball_tree'
  )

  labels = model.fit_predict(coordinate_rad)
  #label is a 1D numpy array, storing cluster ID for each row(i.e. each point/earthquake),
  #i.e. it is a positional array, labels[i] matches row i of coordinate_rad

  n_cluster = len(set(labels)) - (1 if -1 in labels else 0)

  n_noise = list(labels).count(-1)

  cluster_counts = pd.Series(labels[labels != -1]).value_counts() #since value_counts works on series or dataframe, so we are converting labels np array to series
  #Here, labels[labels != -1]  <----- we can perform this type of operation not only on dataframe, but also on Numpy array too!

  largest_cluster = cluster_counts.max() if len(cluster_counts) else 0
  #Here inline/ternary if-else is used. It's syntax is: value_if_true if condition else value_if_false. Ex: status = "Adult" if age >= 18 else "Minor"
  #if we write that code in full form:
  #if len(cluster_count):
  #     largest_cluster = cluster_counts.max()
  #else:
  #     largest_cluster = 0

  results.append({
      'eps_km':eps_km,
      'clusters':n_cluster,
      'noise':n_noise,
      'noise %':round(n_noise/len(df)*100,2),
      'largest_cluster':largest_cluster,
      'largest_cluster %':round(largest_cluster/len(df)*100,2)
  })
  #Here, 'results' itself is a list, but it is storing a dictionary for each value of Eps
  #So, 'results' has become list of dictionaries

  results_df = pd.DataFrame(results)

  print(results_df)
