#Converting the coordinates to Haversine Distance
#Latitude and Longitude represented here are in Euclidean distance
#But the earth is spherical and the Ordinary Euclidean distance doesn't account for the Earth's curvature
#For example, 1° longitude difference means: At the equator ≈ 111 km, while At latitude 60° ≈ 56 km
#So we convert these Euclidean distance into Haversine Distance
#But before that, we have to transfer these Euclidean Latitude and Longitude from degree to radians
#since Haversine Distance in Sci-kit works with radians

import numpy as np

coordinate_deg = df[['latitude', 'longitude']]

coordinate_rad = np.radians(coordinate_deg)

coordinate_rad.head()







#Finding the Best 'Eps' value for DBSCAN model using k-distance graph
#We calculate the distance to its fifth-nearest neighbour using NearestNeighbors Algorithm
#NearestNeighbors is a neighbor-search algorithm, not a trained ML model.
#It doesn't learn anything or make predictions
#It just calculates and stores the distances and indices of nearby points from each point
#Under the hood, it uses: Ball trees, KD-trees, Brute-force distance computation etc., which
#are also just classic computational geometry / algorithm structures, not any learned models. We could implement the same thing without scikit-learn at all
#NearestNeighbors uses fit()(to memorize data for calculation), kneighbors() and kneighbors_graph() functions
#kneighbors() returns two parameters: distances and indices
#for 'distances', Small number → dense area. Large number → sparse/isolated area.
#This is the k-distance graph step of DBSCAN.
#If we plot k_distances (sorted from smallest to largest), we get a curve.
#The "elbow" (knee) of that curve is often used to pick a good value for eps — the radius DBSCAN uses to decide if points are neighbors.
#Flat, low part of the curve → dense clusters.
#Sudden jump / steep rise → transition into noise/outliers.
#Where the curve bends → a good eps value.

from sklearn.neighbors import NearestNeighbors

min_points = 5 #In DBSCAN, 5 is the minimum number of points needed to consider a location "dense"

neighbors = NearestNeighbors(
    n_neighbors=5,
    metric='haversine',
    algorithm='ball_tree'
)

neighbors.fit(coordinate_rad)

distance, index = neighbors.kneighbors(coordinate_rad) #"For each point in coordinates_rad, find its neighbors within coordinates_rad."
# Generally, the query set is different from the reference set:
# neighbors.fit(reference_points)                        ---> provide the reference points first
# distances, indices = neighbors.kneighbors(new_points)  ---> query brand-new points, i.e. distance from the reference points
# but here, both reference and query point dataset are same i.e. 'coordinate_rad'
# if both reference and query point dataset are same,
# then kneighbors() with no argument does exactly the same thing, passing coordinates_rad explicitly is just being verbose


k_distances = distance[:,-1] #This is a dataframe, not a list.
#In dataframe, slicing operation means choosing df[rows, columns]
#So, here : means choosing all rows, -1 means choosing the last column, just as negative index -1 in list means the last element
#[:, -1] means "take the last column" → the distance to the 5th (farthest) nearest neighbor


#In order to plot the distances, we have to convert back the distances from radian to degree(km)
earth_radius = 6371.0088

k_distances_km = np.sort(k_distances*earth_radius)

#Plotting to find the "elbow"
plt.figure(figsize=(10,8))

plt.plot(k_distances_km)
plt.yticks(np.arange(0, k_distances_km.max() + 100, 100))

plt.xlabel("Earthquake (Each point is an Earhtquake)")
plt.ylabel("Distance to the 5th Nearest Neighbor")
plt.title("DBSCAN: Finding the elbow in k-distance curve")

plt.grid(alpha=0.5)
plt.show()





#Applying DBSCAN Model
from sklearn.cluster import DBSCAN

# Convert eps from kilometres to radians
eps_km = 450
eps_rad = eps_km/6371.0088

#DBSCAN
dbscan = DBSCAN(
    eps=eps_rad,
    min_samples=5,
    metric='haversine',
    algorithm='ball_tree'
)


df['cluster'] = dbscan.fit_predict(coordinate_rad)
# In KNN clustering algorithm, we train the model with known features and their labels,
# then during prediction, we give the model NEW data's features to predict its label
# But in DBSCAN, we train the model with unknown features, and it itself creates labels for each cluster
# So, during prediction, we cannot hand it over a new data's unknown feature and ask its label,
# because it cannot generalize to new points — it can't label a point it didn't see during fit()
# there's no meaningful "predict a new point"
# in sklearn, predict on unseen new data effectively re-runs a nearest-neighbor assignment, and is often not what we want
# So fit_predict(X) means: "Run the clustering now, and hand me back the label for every point you just clustered."
# The fit+predict --> these two steps are inseparable for DBSCAN

# Why store it in a 'cluster' column?
# Because the array is just positional — label(e.g. cluster number is 2) at index 5 belongs to row 5 (so the earthquake present at row 5 belongs to cluster 2) of our DataFrame

# DBSCAN labels each cluster with a non-negative integer [...,-1,0,1,2,3,....]
# -1 → noise / outlier (DBSCAN's convention)
# Here -1 means a point which is "not in any cluster", just an individual point,
# while 1,2,3,4,... means cluster IDs




#Counting the total number of clusters that have been created
#but we would not count it if it is negative number since DBSCAN treats negative numbers
#as noise, so in the second expression, we are identifying -1 each time and subtracting it from the length

n_clusters = len(set(df['cluster'])) - (1 if -1 in df['cluster'].values else 0)

#Counting the total number of -1, which means the total number of individual points that are not in any cluster, that are actually outlier or noise
n_noise = list(df['cluster']).count(-1)

print("Number of clusters:", n_clusters)
print("Number of noise points:", n_noise) #i.e. the total number of individual points that are not in any cluster, and since each point is represented by a row
#so the number of rows that are outlier

print("Percentage of Noise: ", round(  n_noise/len(df)  * 100  , 2), "%")
#Here we divide the number of rows that are outlier by total number of rows



#Visualizing the cluster chunks and their sizes when eps is 450km
cluster_sizes = df['cluster'].value_counts()

# Exclude noise
cluster_sizes = cluster_sizes.drop(-1, errors='ignore')

print("Number of clusters:", len(cluster_sizes))

print("\nLargest 15 clusters:")
print(cluster_sizes.head(15))

print("\nSmallest 10 clusters:")
print(cluster_sizes.tail(10))

